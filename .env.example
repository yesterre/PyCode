# Copy this file to .env and fill in your own values.
# .env is ignored by git, so do not commit real API keys.

OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_TYPE=responses

# Optional: set this when using an OpenAI-compatible gateway or proxy.
# Leave it commented when using the official OpenAI API endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# For OpenAI-compatible providers that do not support /responses, use:
# OPENAI_API_TYPE=chat

# Backend-owned bounded LLM transport. SDK retries are per request, never an
# automatic retry of a complete Agent run.
PYCODE_LLM_CONNECT_TIMEOUT_SECONDS=5
PYCODE_LLM_READ_TIMEOUT_SECONDS=180
PYCODE_LLM_WRITE_TIMEOUT_SECONDS=30
PYCODE_LLM_POOL_TIMEOUT_SECONDS=30
PYCODE_LLM_MAX_RETRIES=1

DATABASE_URL=postgresql+psycopg://postgres:你的密码@localhost:5432/pycode_dev

# PostgreSQL connection establishment only; no global statement timeout.
PYCODE_DB_CONNECT_TIMEOUT_SECONDS=5

# Celery broker and temporary coordination store. PostgreSQL remains the
# source of truth for background task business state.
REDIS_URL=redis://localhost:6379/0

# Bound Redis project-lock and broker transport I/O.
PYCODE_REDIS_CONNECT_TIMEOUT_SECONDS=5
PYCODE_REDIS_SOCKET_TIMEOUT_SECONDS=5

# Bounded live Agent trace stream. PostgreSQL stores terminal trace history.
PYCODE_REALTIME_STREAM_MAXLEN=512
PYCODE_REALTIME_STREAM_TTL_SECONDS=86400
PYCODE_REALTIME_SSE_MAX_CONNECTIONS=100

# One initial Git network operation plus at most one bounded local retry.
PYCODE_REPOSITORY_OPERATION_MAX_ATTEMPTS=2
PYCODE_REPOSITORY_RETRY_BASE_DELAY_SECONDS=1
PYCODE_REPOSITORY_RETRY_MAX_DELAY_SECONDS=5

# Renewable project-level workspace lock. The renewal interval must be below TTL.
PYCODE_PROJECT_LOCK_TTL_SECONDS=300
PYCODE_PROJECT_LOCK_RENEW_SECONDS=60

# Queued task broker-publish reconciliation (Celery Beat + Worker).
PYCODE_QUEUED_PUBLISH_GRACE_SECONDS=30
PYCODE_QUEUED_RECONCILE_INTERVAL_SECONDS=30
PYCODE_QUEUED_RECONCILE_BATCH_SIZE=100
PYCODE_QUEUED_RECONCILE_MAX_BACKOFF_SECONDS=120

# Durable Worker execution ownership. Heartbeats renew a PostgreSQL lease from
# a dedicated session; stale-running reconciliation is driven by Celery Beat.
PYCODE_TASK_LEASE_TTL_SECONDS=420
PYCODE_TASK_HEARTBEAT_INTERVAL_SECONDS=30
PYCODE_STALE_RECONCILE_INTERVAL_SECONDS=30
PYCODE_STALE_RECONCILE_BATCH_SIZE=100
PYCODE_STALE_MAX_EXECUTION_ATTEMPTS=2

# Redis delivery redelivery window. This is intentionally much longer than the
# PostgreSQL execution lease and is not a business-operation timeout.
PYCODE_CELERY_VISIBILITY_TIMEOUT_SECONDS=21600

# Used only by PostgreSQL integration tests. Never point this at pycode_dev.
TEST_DATABASE_URL=postgresql+psycopg://postgres:你的密码@localhost:5432/pycode_test
