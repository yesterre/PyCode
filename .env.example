# Copy this file to .env and fill in your own values.
# .env is ignored by git. Never commit real passwords or API keys.

# Docker Compose creates an isolated PostgreSQL database from these values.
# Keep POSTGRES_PASSWORD URL-safe because Compose also places it in DATABASE_URL.
POSTGRES_USER=pycode
POSTGRES_PASSWORD=replace-with-a-url-safe-password
POSTGRES_DB=pycode

# Local Development uses localhost. Docker Compose deliberately overrides these
# three values inside containers with postgres, redis, and the named Workspace.
DATABASE_URL=postgresql+psycopg://postgres:replace-with-local-password@localhost:5432/pycode_dev
REDIS_URL=redis://localhost:6379/0
PYCODE_WORKSPACE_ROOT=.pycode-workspaces

# Effective values inside Docker Compose are equivalent to:
# DATABASE_URL=postgresql+psycopg://pycode:replace-with-a-url-safe-password@postgres:5432/pycode
# REDIS_URL=redis://redis:6379/0
# PYCODE_WORKSPACE_ROOT=/var/lib/pycode/workspaces

OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_TYPE=responses

# Optional: set this when using an OpenAI-compatible gateway or proxy.
# Leave it commented when using the official OpenAI API endpoint.
OPENAI_BASE_URL=

# For OpenAI-compatible providers that do not support /responses, use:
# OPENAI_API_TYPE=chat

# Backend-owned bounded LLM transport. SDK retries are per request, never an
# automatic retry of a complete Agent run.
PYCODE_LLM_CONNECT_TIMEOUT_SECONDS=5
PYCODE_LLM_READ_TIMEOUT_SECONDS=180
PYCODE_LLM_WRITE_TIMEOUT_SECONDS=30
PYCODE_LLM_POOL_TIMEOUT_SECONDS=30
PYCODE_LLM_MAX_RETRIES=1

# PostgreSQL connection establishment only; no global statement timeout.
PYCODE_DB_CONNECT_TIMEOUT_SECONDS=5

# B02 auth only. Generate a random secret locally; never commit its value:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Missing/invalid settings make auth endpoints return 503. Existing resource
# authorization is added separately in B03-B06; B02 alone is not user isolation.
PYCODE_JWT_SECRET=
PYCODE_JWT_ALGORITHM=HS256
PYCODE_ACCESS_TOKEN_TTL_SECONDS=900

# Celery broker and temporary coordination store. PostgreSQL remains the
# source of truth for background task business state.
# Bound Redis project-lock and broker transport I/O.
PYCODE_REDIS_CONNECT_TIMEOUT_SECONDS=5
PYCODE_REDIS_SOCKET_TIMEOUT_SECONDS=5

# Per-user expensive work: windows start at the first admitted request for each
# operation. ask/impact share the analysis budget. Positive integers only.
# Redis failure rejects new work with 503; idempotent replays bypass admission.
PYCODE_RATE_WINDOW_SECONDS=60
PYCODE_RATE_INDEX_REQUESTS=10
PYCODE_RATE_AGENT_REQUESTS=20
PYCODE_RATE_ANALYSIS_REQUESTS=30
# Includes queued and running tasks across all owned projects, even archived
# projects. Terminal tasks free capacity; PostgreSQL remains the task truth.
PYCODE_MAX_ACTIVE_TASKS_PER_USER=4

# Bounded live Agent trace stream. PostgreSQL stores terminal trace history.
PYCODE_REALTIME_STREAM_MAXLEN=512
PYCODE_REALTIME_STREAM_TTL_SECONDS=86400
PYCODE_REALTIME_SSE_MAX_CONNECTIONS=100

# One initial Git network operation plus at most one bounded local retry.
PYCODE_GIT_ALLOWED_HOSTS=github.com,gitlab.com,gitee.com
PYCODE_GIT_TIMEOUT_SECONDS=120
PYCODE_REPOSITORY_OPERATION_MAX_ATTEMPTS=2
PYCODE_REPOSITORY_RETRY_BASE_DELAY_SECONDS=1
PYCODE_REPOSITORY_RETRY_MAX_DELAY_SECONDS=5

# Renewable project-level workspace lock. The renewal interval must be below TTL.
PYCODE_PROJECT_LOCK_TTL_SECONDS=300
PYCODE_PROJECT_LOCK_RENEW_SECONDS=60

# Queued task broker-publish reconciliation (Celery Beat + Worker).
PYCODE_QUEUED_PUBLISH_GRACE_SECONDS=30
PYCODE_QUEUED_RECONCILE_INTERVAL_SECONDS=30
PYCODE_QUEUED_RECONCILE_BATCH_SIZE=100
PYCODE_QUEUED_RECONCILE_MAX_BACKOFF_SECONDS=120

# Durable Worker execution ownership. Heartbeats renew a PostgreSQL lease from
# a dedicated session; stale-running reconciliation is driven by Celery Beat.
PYCODE_TASK_LEASE_TTL_SECONDS=420
PYCODE_TASK_HEARTBEAT_INTERVAL_SECONDS=30
PYCODE_STALE_RECONCILE_INTERVAL_SECONDS=30
PYCODE_STALE_RECONCILE_BATCH_SIZE=100
PYCODE_STALE_MAX_EXECUTION_ATTEMPTS=2

# Redis delivery redelivery window. This is intentionally much longer than the
# PostgreSQL execution lease and is not a business-operation timeout.
PYCODE_CELERY_VISIBILITY_TIMEOUT_SECONDS=21600

# Public frontend build-time setting. Keep empty for same-origin Nginx /api proxy.
# Never place a secret in a VITE_* variable.
VITE_API_BASE_URL=

# Test-only configuration. Never point TEST_DATABASE_URL at pycode_dev.
TEST_DATABASE_URL=postgresql+psycopg://postgres:replace-with-test-password@localhost:5432/pycode_test
TEST_REDIS_URL=redis://localhost:6379/15
