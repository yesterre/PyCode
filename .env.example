# Copy this file to .env and fill in your own values.
# .env is ignored by git, so do not commit real API keys.

OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_TYPE=responses

# Optional: set this when using an OpenAI-compatible gateway or proxy.
# Leave it commented when using the official OpenAI API endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# For OpenAI-compatible providers that do not support /responses, use:
# OPENAI_API_TYPE=chat
